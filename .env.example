# Environment Variables

## Flutterwave (Payment Provider)
FLUTTERWAVE_SECRET_KEY=sk_test_...
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_webhook_secret_hash

## Clerk (Authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Localhost requires a Clerk development key (pk_test_...). Clerk production
# keys (pk_live_...) are rejected on localhost by Clerk.
CLERK_SECRET_KEY=sk_test_...

## MongoDB
MONGODB_URI=mongodb+srv://...

## Privy (Wallet Custody)
PRIVY_APP_ID=...
PRIVY_APP_SECRET=...
NEW_PRIVY_APP_ID=...
NEW_PRIVY_APP_SECRET=...
# Privy wallet-auth authorization key. A PRIVATE KEY: it belongs in .env.local
# and nowhere else. Never paste a real one here — this file is committed.
PRIV_KEY_ADMIN=wallet-auth:...
ID_ADMIN=...
THIRD_PRIVY_APP_ID=...
THIRD_PRIVY_APP_SECRET=...
# Fourth app (privy_type 3 — current signup app)
FOURTH_PRIVY_APP_ID=...
FOURTH_PRIVY_APP_SECRET=...

## worldstreet-crypto service
# Base URL the dedicated /api/crypto/[...path] proxy forwards to. Server-only
# — NOT NEXT_PUBLIC_, the proxy runs server-side and the browser never sees it.
CRYPTO_API_URL=https://crypto-backend.worldstreetgold.com
# Modern self-custodial wallet UI. Off by default — see docs/CRYPTO-ROLLOUT-AND-SOAK.md
# before enabling anywhere user-facing.
NEXT_PUBLIC_CRYPTO_ENABLED=false
NEXT_PUBLIC_CRYPTO_PROXY_ENABLED=true
NEXT_PUBLIC_CRYPTO_BACKEND_CONTRACT_VERSION=b00e793
# Keep legacy Privy wallet screens/methods available during dual-run rollout.
NEXT_PUBLIC_LEGACY_PRIVY_ENABLED=true

## Admin Backend (Treasury)
ADMIN_BACKEND_URL=https://...
ADMIN_BACKEND_API_KEY=...
ADMIN_WEBHOOK_SECRET=...

## CoinGecko (Exchange Rates)
# No API key required for free tier

## RPC Endpoints
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_ETH_RPC=https://cloudflare-eth.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
GMX_ORACLE_URL=https://arbitrum-api.gmxinfra.io
GMX_SUBSQUID_URL=https://gmx.squids.live/gmx-synthetics-arbitrum:prod/api/graphql
TRON_RPC_URL=https://api.trongrid.io
TRON_API_KEY=...

## Gas Sponsorship
GAS_SPONSORSHIP_ENABLED=true

## OpenAI (Vivid Voice)
OPENAI_API_KEY=sk-...

## worldstreet-wallet service (Dollar Account balance read via proxy)
WALLET_API_URL=https://wallet-api.worldstreetgold.com

# Self-custody wallet backend (worldstreet-crypto-backend). Flag "1" enables /wallet.
NEXT_PUBLIC_CRYPTO_BACKEND_URL=https://crypto-backend.worldstreetgold.com
NEXT_PUBLIC_SELF_CUSTODY_ENABLED=0

# Do not set NEXT_PUBLIC_SELF_CUSTODY_ENABLED=1 in production until the Clerk
# audience question (docs/self-custody/questions-for-tom.md #1) is resolved —
# plain session tokens will 401 if the backend enforces CLERK_JWT_AUDIENCE.
